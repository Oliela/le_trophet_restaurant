// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  events Event[]
}

model Event {
  id             String       @id @default(cuid())
  title          String
  slug           String       @unique
  description    String
  pricingDetails String?
  scheduleType   ScheduleType @default(ONE_DAY)

  startsAt         DateTime
  endsAt           DateTime?
  recurrenceDay    Int?
  recurrenceEndsAt DateTime?

  capacity     Int?
  imageUrl     String?
  pollEnabled  Boolean   @default(false)
  pollQuestion String?
  published    Boolean   @default(false)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdById String?
  createdBy   Admin?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  responses   PollResponse[]

  @@index([published, startsAt])
  @@index([scheduleType, recurrenceDay])
}

model PollResponse {
  id                 String     @id @default(cuid())
  answer             PollAnswer
  participantName    String?
  whatsapp           String
  occurrenceStartsAt DateTime
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, occurrenceStartsAt, whatsapp])
  @@index([eventId, occurrenceStartsAt, answer])
}

enum ScheduleType {
  ONE_DAY
  DATE_RANGE
  WEEKLY
}

enum PollAnswer {
  YES
  NO
}
